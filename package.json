{
  "name": "music-hub",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "biome lint && bun run --sequential --filter '@music-hub/*' check",
    "test": "bun run --sequential --filter '@music-hub/*' test",
    "db:generate": "turbo db:generate --filter=@music-hub/db",
    "db:migrate": "turbo db:migrate --filter=@music-hub/db",
    "db:seed": "turbo db:seed --filter=@music-hub/db"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "latest",
    "typescript": "^5",
    "@biomejs/biome": "^2.5.15"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
