{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/{index,worker,login-link}.ts",
        "src/services/{music-analysis,mix-measurement}.ts",
        "src/scripts/*.ts",
        "src/**/*.test.ts"
      ]
    },
    "apps/cli": {
      "entry": ["src/main.ts", "src/**/*.test.ts"]
    }
  }
}
