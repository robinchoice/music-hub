{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The tests import the API, its env types come along
  "include": ["src", "build.ts", "../api/src/env.ts"]
}
