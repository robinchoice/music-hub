# === PFLICHT ===

# Öffentliche URL der App (ohne Trailing-Slash)
APP_URL=https://hub.pleasance.org

# Weitere Browser-Origins, kommagetrennt (z. B. alte Domain während einer Umstellung)
ADDITIONAL_ORIGINS=https://hub.diespaetzles.lol

# Postgres-Passwort — lang und zufällig, z.B.: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Magic-Link-Secret — lang und zufällig, z.B.: openssl rand -hex 32
MAGIC_LINK_SECRET=CHANGE_ME

# === EMAIL (ohne = Magic Links nur in API-Log) ===

# SMTP-Zugang, z. B. Proton Mail (Passwort = SMTP-Token der Absenderadresse)
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@diespaetzles.lol
SMTP_PASS=CHANGE_ME
EMAIL_FROM=Music Hub <noreply@diespaetzles.lol>

# === S3 / MINIO (Defaults passen für eingebautes MinIO) ===

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=music-hub

# === OPTIONAL ===

# Externer Port (Coolify mappt das auf die Domain)
PORT=3000

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@musichub.app
