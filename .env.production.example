# === PFLICHT ===

# Öffentliche URL der App (ohne Trailing-Slash)
APP_URL=https://music.example.com

# Postgres-Passwort — lang und zufällig, z.B.: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# Speichergrenze von Postgres, Standard 512m
POSTGRES_MEMORY=

# === S3 (Bucket mit HTTPS-Endpunkt, Browser laden direkt hoch und streamen von dort) ===

# z. B. Hetzner Object Storage: https://nbg1.your-objectstorage.com
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=music-hub

# === EMAIL (Pflicht, ohne SMTP_HOST startet die API nicht) ===

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
EMAIL_FROM=Music Hub <noreply@example.com>

# Pause zwischen zwei Update-Mails in ms, Protons SMTP begrenzt die Rate. Standard 6000
UPDATE_MAIL_INTERVAL_MS=

# === OPTIONAL ===

# Weitere Browser-Origins, kommagetrennt (z. B. alte Domain während einer Umstellung)
ADDITIONAL_ORIGINS=

# Lokaler Port, auf den der Reverse Proxy zeigt
PORT=3000

# Adressen mit Zugang zu den Admin-Seiten unter /admin, kommagetrennt
ADMIN_EMAILS=

# Push Notifications (VAPID), Schlüssel z. B. mit: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Verschlüsselt die Wallet-Verbindungen (NWC) der Studios, 32 Bytes als base64: openssl rand -base64 32
# Leer = keine Lightning-Zahlungen. Nicht wechseln, sonst sind gespeicherte Verbindungen unlesbar.
PAYMENT_SECRETS_KEY=

# Tarife Pro und Studio (README, „Tarife“). Leer = kein Kauf mit dieser Zahlungsart.
# Stripe: geheimer API-Key und Signatur-Secret des Webhooks auf <APP_URL>/api/v1/billing/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# BTCPay Server: Greenfield-API-Key mit Rechnungsrechten für einen Store, Webhook auf <APP_URL>/api/v1/billing/btcpay
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# GlitchTip/Sentry, leer = aus. SENTRY_* für API, Worker und Web-Server, PUBLIC_SENTRY_* für den Browser
SENTRY_DSN=
SENTRY_ENVIRONMENT=
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=
